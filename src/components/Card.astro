---
interface Props {
  title: string;
  description: string;
  icon?: string;
  href?: string;
}

const { title, description, icon = "🎵", href } = Astro.props;
---

<div class="group bg-white/5 backdrop-blur border border-pink-500/30 rounded-lg p-6 hover:border-pink-500 hover:bg-white/10 transition duration-300">
  {icon && <div class="text-4xl mb-4 group-hover:scale-110 transition duration-300">{icon}</div>}
  <h3 class="text-lg font-bold mb-2 group-hover:text-pink-400 transition">{title}</h3>
  <p class="text-gray-400 text-sm leading-relaxed mb-4">{description}</p>
  {href && (
    <a href={href} class="text-pink-400 hover:text-pink-300 font-semibold text-sm inline-flex items-center gap-2">
      Ver más →
    </a>
  )}
  <slot />
</div>
