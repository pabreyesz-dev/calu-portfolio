---
interface Props {
  title: string;
  description: string;
  icon?: string;
  href?: string;
}

const { title, description, icon = "🎵", href } = Astro.props;
---

<div class="group bg-white/5 backdrop-blur border rounded-lg p-6 hover:bg-white/10 transition duration-300 card-border">
  {icon && <div class="text-4xl mb-4 group-hover:scale-110 transition duration-300">{icon}</div>}
  <h3 class="text-lg font-bold mb-2 group-hover:text-accent transition card-title">{title}</h3>
  <p class="text-gray-400 text-sm leading-relaxed mb-4">{description}</p>
  {href && (
    <a href={href} class="font-semibold text-sm inline-flex items-center gap-2 card-link">
      Ver más →
    </a>
  )}
  <slot />
</div>

<style>
  .card-border {
    border-color: var(--primary-color, #EC4899);
    border-opacity: 0.3;
  }
  .card-border:hover {
    border-color: var(--primary-color, #EC4899);
    border-opacity: 1;
  }
  .card-title {
    color: inherit;
  }
  .card-title:hover {
    color: var(--accent-color, #F472B6);
  }
  .card-link {
    color: var(--accent-color, #F472B6);
  }
  .card-link:hover {
    color: var(--primary-color, #EC4899);
  }
</style>
