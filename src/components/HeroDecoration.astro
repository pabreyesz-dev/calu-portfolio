---
// Componente decorativo SVG para el hero
---

<svg 
  viewBox="0 0 1000 1000" 
  class="w-full h-full opacity-20 absolute inset-0"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:rgb(236,72,153);stop-opacity:0.5" />
      <stop offset="100%" style="stop-color:rgb(236,72,153);stop-opacity:0" />
    </linearGradient>
  </defs>

  <!-- Ondas de sonido -->
  <circle cx="500" cy="500" r="100" fill="none" stroke="url(#grad1)" stroke-width="2" opacity="0.6" />
  <circle cx="500" cy="500" r="200" fill="none" stroke="url(#grad1)" stroke-width="2" opacity="0.4" />
  <circle cx="500" cy="500" r="300" fill="none" stroke="url(#grad1)" stroke-width="2" opacity="0.2" />

  <!-- Líneas geométricas -->
  <line x1="200" y1="300" x2="800" y2="300" stroke="url(#grad1)" stroke-width="1" opacity="0.3" />
  <line x1="200" y1="700" x2="800" y2="700" stroke="url(#grad1)" stroke-width="1" opacity="0.3" />

  <!-- Puntos conectados -->
  <circle cx="300" cy="400" r="3" fill="rgb(236,72,153)" opacity="0.4" />
  <circle cx="700" cy="400" r="3" fill="rgb(236,72,153)" opacity="0.4" />
  <circle cx="500" cy="600" r="3" fill="rgb(236,72,153)" opacity="0.4" />
  <line x1="300" y1="400" x2="700" y2="400" stroke="rgb(236,72,153)" stroke-width="0.5" opacity="0.2" />
  <line x1="300" y1="400" x2="500" y2="600" stroke="rgb(236,72,153)" stroke-width="0.5" opacity="0.2" />
  <line x1="700" y1="400" x2="500" y2="600" stroke="rgb(236,72,153)" stroke-width="0.5" opacity="0.2" />
</svg>

<style>
  @keyframes pulse-circle {
    0%, 100% {
      r: 100;
      opacity: 0.6;
    }
    100% {
      r: 300;
      opacity: 0;
    }
  }

  circle:first-of-type {
    animation: pulse-circle 2s ease-out infinite;
  }
</style>
