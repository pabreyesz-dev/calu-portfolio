      <li><a href="/galery" class="transition duration-300" style="color: inherit;" onmouseover="this.style.color = 'var(--accent-color, #F472B6)'" onmouseout="this.style.color = 'inherit'">Galería</a></li>
      <li><a href="/events" class="transition duration-300" style="color: inherit;" onmouseover="this.style.color = 'var(--accent-color, #F472B6)'" onmouseout="this.style.color = 'inherit'">Eventos</a></li>
      <li><a href="/press" class="transition duration-300" style="color: inherit;" onmouseover="this.style.color = 'var(--accent-color, #F472B6)'" onmouseout="this.style.color = 'inherit'">Prensa</a></li>
      <li><a href="/contact" class="transition duration-300" style="color: inherit;" onmouseover="this.style.color = 'var(--accent-color, #F472B6)'" onmouseout="this.style.color = 'inherit'">Contacto</a></li>
