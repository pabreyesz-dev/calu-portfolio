    <!-- Hamburger Menu Mobile -->
    <button id="mobileMenuBtn" class="md:hidden text-white focus:outline-none" aria-label="Abrir menú">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
