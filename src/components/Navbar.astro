  </div>

  <!-- Mobile Menu -->
  <div id="mobileMenu" class="hidden md:hidden bg-black/95 border-t" style="border-color: var(--primary-color, #EC4899) + '33'">
    <ul class="flex flex-col gap-4 text-sm uppercase tracking-wider text-white p-6">
      <li><a href="/" class="transition duration-300 block" onmouseover="this.style.color = 'var(--accent-color, #F472B6)'" onmouseout="this.style.color = 'inherit'">Inicio</a></li>
      <li><a href="/biography" class="transition duration-300 block" onmouseover="this.style.color = 'var(--accent-color, #F472B6)'" onmouseout="this.style.color = 'inherit'">Biografía</a></li>
      <li><a href="/music" class="transition duration-300 block" onmouseover="this.style.color = 'var(--accent-color, #F472B6)'" onmouseout="this.style.color = 'inherit'">Música</a></li>
