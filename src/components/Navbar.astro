  <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
    
    <!-- Logo / Nombre artista -->
    <a href="/" class="text-white text-2xl font-bold tracking-wide font-['Playfair_Display'] hover:opacity-80 transition">
      CALÚ
    </a>

    <!-- Links Desktop -->
    <ul class="hidden md:flex gap-8 text-xs uppercase tracking-wider text-white">
      <li><a href="/" class="transition duration-300" style="color: inherit; --tw-text-opacity: 1; --hover-color: var(--accent-color, #F472B6);" onmouseover="this.style.color = 'var(--accent-color, #F472B6)'" onmouseout="this.style.color = 'inherit'">Inicio</a></li>
      <li><a href="/biography" class="transition duration-300" style="color: inherit;" onmouseover="this.style.color = 'var(--accent-color, #F472B6)'" onmouseout="this.style.color = 'inherit'">Biografía</a></li>
