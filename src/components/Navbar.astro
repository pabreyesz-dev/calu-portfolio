    <!-- Logo / Nombre artista -->
    <a href="/" class="text-white text-2xl font-bold tracking-wide font-['Playfair_Display'] hover:opacity-80 transition">
      CALÚ
    </a>

    <!-- Links Desktop -->
    <ul class="hidden md:flex gap-8 text-xs uppercase tracking-wider text-white">
      <li><a href="/" class="transition duration-300 nav-link" data-i18n="myMusic" data-nav-link>Mi Música</a></li>
      <li><a href="/biography" class="transition duration-300 nav-link" data-i18n="biography" data-nav-link>Biografía</a></li>
      <li><a href="/galery" class="transition duration-300 nav-link" data-i18n="galery" data-nav-link>Galería</a></li>
      <li><a href="/events" class="transition duration-300 nav-link" data-i18n="events" data-nav-link>Eventos</a></li>
      <li><a href="/press" class="transition duration-300 nav-link" data-i18n="press" data-nav-link>Prensa</a></li>
      <li><a href="/contact" class="transition duration-300 nav-link" data-i18n="contact" data-nav-link>Contacto</a></li>
    </ul>

    <!-- Hamburger Menu Mobile -->
    <button id="mobileMenuBtn" class="md:hidden text-white focus:outline-none" aria-label="Abrir menú">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>

  </div>

  <!-- Mobile Menu -->
  <div id="mobileMenu" class="hidden md:hidden bg-black/95 border-t" style="border-color: var(--primary-color, #EC4899)">
    <ul class="flex flex-col gap-4 text-sm uppercase tracking-wider text-white p-6">
      <li><a href="/" class="transition duration-300 block nav-link" data-i18n="myMusic" data-nav-link>Mi Música</a></li>
      <li><a href="/biography" class="transition duration-300 block nav-link" data-i18n="biography" data-nav-link>Biografía</a></li>
      <li><a href="/galery" class="transition duration-300 block nav-link" data-i18n="galery" data-nav-link>Galería</a></li>
