---
import SocialLinks from './SocialLinks.astro';
---
<footer class="bg-black text-white border-t" style="border-color: var(--primary-color, #EC4899)">
  <div class="max-w-7xl mx-auto px-6 py-16">
    
    <!-- Grid de contenido -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">
      
      <!-- Sección de marca -->
      <div class="space-y-4">
        <h3 class="text-2xl font-bold font-['Playfair_Display']">CALÚ</h3>
        <p class="text-sm text-gray-400 leading-relaxed" data-i18n="footerDesc">
          Cantante, compositora y artista. Explorando nuevos sonidos y emociones a través de la música.
        </p>
      </div>

      <!-- Enlaces rápidos -->
      <div class="space-y-4">
        <h4 class="text-lg font-semibold uppercase tracking-wider" data-i18n="links">Enlaces</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/" class="text-gray-400 hover-link transition duration-300" data-i18n="myMusic">Mi Música</a></li>
          <li><a href="/biography" class="text-gray-400 hover-link transition duration-300" data-i18n="biography">Biografía</a></li>
          <li><a href="/galery" class="text-gray-400 hover-link transition duration-300" data-i18n="galery">Galería</a></li>
          <li><a href="/events" class="text-gray-400 hover-link transition duration-300" data-i18n="events">Eventos</a></li>
        </ul>
      </div>

      <!-- Redes sociales -->
      <div class="space-y-4">
        <h4 class="text-lg font-semibold uppercase tracking-wider" data-i18n="followMe">Sígueme</h4>
        <SocialLinks />
      </div>
    </div>

    <!-- Divisor -->
    <div class="border-t border-gray-800 my-8"></div>

    <!-- Copyright -->
    <div class="text-center space-y-2">
      <p class="text-sm text-gray-400">
        © {new Date().getFullYear()} CALÚ ® <span data-i18n="footerRights">Todos los derechos reservados.</span>
      </p>
      <p class="text-xs text-gray-500" data-i18n="footerCredit">
        Diseñado y desarrollado con ❤️ por pachito
      </p>
    </div>

  </div>
</footer>

<style>
  .hover-link:hover {
    color: var(--accent-color, #F472B6);
  }
</style>
