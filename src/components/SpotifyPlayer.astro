---
// Componente para reproducir canciones de Spotify directamente en la web
interface Props {
  trackId?: string;
  albumId?: string;
  width?: string;
  height?: string;
  theme?: 'black' | 'white';
}

const { 
  trackId, 
  albumId, 
  width = '100%', 
  height = '352',
  theme = 'black'
} = Astro.props;

// Si hay trackId, usar reproductor de canción, si no, usar álbum
const spotifyUrl = trackId 
  ? `https://open.spotify.com/track/${trackId}`
  : `https://open.spotify.com/album/${albumId}`;
---

<div class="spotify-player-container">
  <iframe
    style="border-radius: 12px"
    src={trackId 
      ? `https://open.spotify.com/embed/track/${trackId}?utm_source=generator&theme=${theme}`
      : `https://open.spotify.com/embed/album/${albumId}?utm_source=generator&theme=${theme}`
    }
    width={width}
    height={height}
    frameBorder="0"
    allowfullscreen
    allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
    loading="lazy"
  ></iframe>
</div>

<style>
  .spotify-player-container {
    width: 100%;
    max-width: 100%;
  }
  
  .spotify-player-container iframe {
    width: 100%;
    min-height: 352px;
  }
</style>

