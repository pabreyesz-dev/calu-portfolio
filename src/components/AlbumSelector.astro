---
// AlbumSelector.astro - Selector de álbumes que cambia el tema según el color del álbum
---

<div id="album-selector" class="album-selector-container">
  <!-- Los álbumes se cargarán dinámicamente aquí -->
</div>

<script>
  import { generateThemeColors } from '../lib/spotify.ts';
  
  interface Album {
    id: string;
    name: string;
    image: string;
    releaseDate: string;
    spotifyUrl: string;
    type: 'album' | 'single' | 'ep';
  }
  
  // Álbumes de Calú - Solo álbumes completos
  const albums: Album[] = [
    {
      id: 'sie7e-oros',
      name: 'Sie7e Oros',
      image: 'https://i.scdn.co/image/ab67616d00001e027a61ffa277fdb11effa9f331', // Agregar URL de la portada de Spotify
      releaseDate: '2024',
      spotifyUrl: 'https://open.spotify.com/intl-es/album/1ZOvp7GbLBrR7BYQAtnx6b', // Agregar URL del álbum en Spotify
      type: 'album'
    },
    {
      id: 'la-emperatriz',
      name: 'La Emperatriz',
      image: 'https://i.scdn.co/image/ab67616d00001e02cdfcd7f820fc97b03a25c003', // Agregar URL de la portada de Spotify
      releaseDate: '2022',
      spotifyUrl: 'https://open.spotify.com/intl-es/album/5JCtZj21x2ghlRUt5VDXfK', // Agregar URL del álbum en Spotify
      type: 'album'
    },
    {
      id: 'liberacion',
      name: 'Liberación',
      image: 'https://i.scdn.co/image/ab67616d00001e028c1c9c1ed513b73c3572382c', // Agregar URL de la portada de Spotify
      releaseDate: '2018',
      spotifyUrl: 'https://open.spotify.com/intl-es/album/1IjOoCFIoJdH0nRBBiTObO', // Agregar URL del álbum en Spotify
      type: 'album'
    }
  ];
  
  // Función para extraer color predominante
  async function extractDominantColor(imageUrl: string): Promise<string> {
    return new Promise((resolve) => {
      const img = new Image();
      img.crossOrigin = 'anonymous';
      
      img.onload = () => {
        const canvas = document.createElement('canvas');
        const ctx = canvas.getContext('2d');
        if (!ctx) {
          resolve('#EC4899');
          return;
        }
        
        canvas.width = Math.min(img.width, 100);
        canvas.height = Math.min(img.height, 100);
        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
        
        const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
        const data = imageData.data;
        
        let r = 0, g = 0, b = 0;
        let count = 0;
        
        for (let i = 0; i < data.length; i += 4) {
          r += data[i];
          g += data[i + 1];
          b += data[i + 2];
          count++;
        }
        
        r = Math.floor(r / count);
        g = Math.floor(g / count);
        b = Math.floor(b / count);
        
        const hex = `#${[r, g, b].map(x => {
          const hex = x.toString(16);
          return hex.length === 1 ? '0' + hex : hex;
        }).join('')}`;
        
        resolve(hex);
      };
      
      img.onerror = () => {
        resolve('#EC4899');
      };
      
      img.src = imageUrl;
    });
  }
  
  // Aplicar tema basado en color
  function applyAlbumTheme(primaryColor: string) {
    const colors = generateThemeColors(primaryColor);
    const root = document.documentElement;
    
    root.style.setProperty('--primary-color', colors.primary);
    root.style.setProperty('--accent-color', colors.accent);
    root.style.setProperty('--secondary-color', colors.secondary);
    
    localStorage.setItem('album-theme', JSON.stringify(colors));
    localStorage.setItem('selected-album', primaryColor);
  }
  
  // Renderizar álbumes
  function renderAlbums() {
    const container = document.getElementById('album-selector');
    if (!container) return;
    
    container.innerHTML = albums.map(album => `
      <div class="album-item" data-album-id="${album.id}">
        <img 
          src="${album.image}" 
          alt="${album.name}"
          class="album-cover"
          loading="lazy"
        />
        <div class="album-info">
          <h3 class="album-name">${album.name}</h3>
          <p class="album-year">${album.releaseDate}</p>
        </div>
      </div>
    `).join('');
    
    // Agregar event listeners
    container.querySelectorAll('.album-item').forEach(item => {
      item.addEventListener('click', async () => {
        const albumId = item.getAttribute('data-album-id');
        const album = albums.find(a => a.id === albumId);
        if (!album) return;
        
        // Extraer color y aplicar tema
        const color = await extractDominantColor(album.image);
        applyAlbumTheme(color);
        
        // Actualizar estado visual
        container.querySelectorAll('.album-item').forEach(i => {
          i.classList.remove('active');
        });
        item.classList.add('active');
      });
    });
    
    // Cargar colores de las imágenes
    container.querySelectorAll('.album-cover').forEach((img, index) => {
      const album = albums[index];
      if (album) {
        extractDominantColor(album.image).then(color => {
          const item = container.querySelector(`[data-album-id="${album.id}"]`);
          if (item) {
            (item as HTMLElement).style.setProperty('--album-color', color);
          }
        });
      }
    });
  }
  
  // Cargar tema guardado
  function loadSavedTheme() {
    const saved = localStorage.getItem('album-theme');
    if (saved) {
      try {
        const colors = JSON.parse(saved);
        const root = document.documentElement;
        root.style.setProperty('--primary-color', colors.primary);
        root.style.setProperty('--accent-color', colors.accent);
        root.style.setProperty('--secondary-color', colors.secondary);
      } catch (e) {
        console.error('Error loading saved theme:', e);
      }
    }
  }
  
  // Inicializar
  if (typeof window !== 'undefined') {
    window.addEventListener('DOMContentLoaded', () => {
      loadSavedTheme();
      renderAlbums();
    });
  }
</script>

<style>
  .album-selector-container {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 1.5rem;
    padding: 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }
  
  .album-item {
    cursor: pointer;
    transition: all 0.3s ease;
    border-radius: 12px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    border: 2px solid transparent;
  }
  
  .album-item:hover {
    transform: translateY(-5px);
    border-color: var(--primary-color, #EC4899);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  }
  
  .album-item.active {
    border-color: var(--primary-color, #EC4899);
    box-shadow: 0 0 20px var(--primary-color, #EC4899);
  }
  
  .album-cover {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    display: block;
  }
  
  .album-info {
    padding: 1rem;
    text-align: center;
  }
  
  .album-name {
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
    color: white;
  }
  
  .album-year {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.6);
  }
  
  @media (max-width: 768px) {
    .album-selector-container {
      grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
      gap: 1rem;
      padding: 1rem;
    }
  }
</style>

