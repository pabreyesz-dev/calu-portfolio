---
import MainLayout from "../layouts/MainLayout.astro";
import SectionTitle from "../components/SectionTitle.astro";
---

<MainLayout title="Música | CALÚ">
  <!-- Hero Section -->
  <section class="relative min-h-screen flex items-center justify-center text-center px-6 pt-10 bg-linear-to-br from-black via-pink-950/20 to-black">
    <div class="max-w-4xl z-10">
      <h1 class="text-6xl md:text-7xl font-bold font-['Playfair_Display'] mb-6">
        Mi Música
      </h1>
      <p class="text-xl text-gray-300 mb-8">
        Descubre mis últimas composiciones y colaboraciones
      </p>
    </div>
  </section>

  <!-- Plataformas Streaming -->
  <section class="py-20 md:py-32 bg-linear-to-b from-black to-pink-950/5">
    <div class="max-w-6xl mx-auto px-6">
      <SectionTitle 
        title="Escucha en Todas Partes"
        subtitle="Mi música disponible en todas las plataformas"
      />
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="group bg-white/5 backdrop-blur border border-pink-500/30 rounded-lg p-8 hover:border-pink-500 hover:bg-white/10 transition duration-300">
          <div class="text-5xl mb-4 group-hover:scale-110 transition duration-300">🎵</div>
          <h3 class="text-2xl font-bold mb-2">Último Álbum</h3>
          <p class="text-gray-400 mb-6">Escucha la colección completa en Spotify, Apple Music y más plataformas</p>
          <a href="#" class="text-pink-400 hover:text-pink-300 font-semibold">Escuchar en Spotify →</a>
        </div>
        
        <div class="group bg-white/5 backdrop-blur border border-pink-500/30 rounded-lg p-8 hover:border-pink-500 hover:bg-white/10 transition duration-300">
          <div class="text-5xl mb-4 group-hover:scale-110 transition duration-300">⭐</div>
          <h3 class="text-2xl font-bold mb-2">Top Canciones</h3>
          <p class="text-gray-400 mb-6">Las más escuchadas y favoritas del público en todas las plataformas</p>
          <a href="#" class="text-pink-400 hover:text-pink-300 font-semibold">Ver playlist →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Canciones Recientes -->
  <section class="py-20 md:py-32 bg-black">
    <div class="max-w-6xl mx-auto px-6">
      <SectionTitle 
        title="Canciones Recientes"
        subtitle="Mis últimos lanzamientos"
      />
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="group">
          <div class="aspect-square bg-linear-to-br from-pink-600 to-pink-900 rounded-lg mb-4 flex items-center justify-center group-hover:scale-105 transition duration-300 cursor-pointer">
            <div class="text-center">
              <p class="text-6xl mb-2">♪</p>
              <button class="bg-pink-500 hover:bg-pink-600 px-4 py-2 rounded-lg text-sm font-semibold transition">Play</button>
            </div>
          </div>
          <h3 class="font-bold text-lg group-hover:text-pink-400 transition">Canción 1</h3>
          <p class="text-gray-400 text-sm">2025 • 3:45</p>
        </div>
        
        <div class="group">
          <div class="aspect-square bg-linear-to-br from-pink-700 to-purple-900 rounded-lg mb-4 flex items-center justify-center group-hover:scale-105 transition duration-300 cursor-pointer">
            <div class="text-center">
              <p class="text-6xl mb-2">♪</p>
              <button class="bg-pink-500 hover:bg-pink-600 px-4 py-2 rounded-lg text-sm font-semibold transition">Play</button>
            </div>
          </div>
          <h3 class="font-bold text-lg group-hover:text-pink-400 transition">Canción 2</h3>
          <p class="text-gray-400 text-sm">2025 • 4:12</p>
        </div>
        
        <div class="group">
          <div class="aspect-square bg-linear-to-br from-rose-600 to-pink-900 rounded-lg mb-4 flex items-center justify-center group-hover:scale-105 transition duration-300 cursor-pointer">
            <div class="text-center">
              <p class="text-6xl mb-2">♪</p>
              <button class="bg-pink-500 hover:bg-pink-600 px-4 py-2 rounded-lg text-sm font-semibold transition">Play</button>
            </div>
          </div>
          <h3 class="font-bold text-lg group-hover:text-pink-400 transition">Canción 3</h3>
          <p class="text-gray-400 text-sm">2024 • 3:28</p>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
