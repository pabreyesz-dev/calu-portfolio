---
import MainLayout from "../layouts/MainLayout.astro";
import Button from "../components/Button.astro";
import HeroDecoration from "../components/HeroDecoration.astro";
import SectionTitle from "../components/SectionTitle.astro";
import AlbumSelector from "../components/AlbumSelector.astro";
import SongCard from "../components/SongCard.astro";
import YouTubeVideoCard from "../components/YouTubeVideoCard.astro";
import Card from "../components/Card.astro";
import { songs } from "../lib/songs.ts";
import { youtubeVideos } from "../lib/youtube.ts";
---

<MainLayout title="Mi Música | CALÚ">
  <!-- Hero Section -->
  <section class="relative min-h-screen flex items-center justify-center text-center px-6 overflow-hidden">
    <!-- Fondo degradado dinámico -->
    <div class="absolute inset-0 hero-background z-0"></div>

    <!-- Decoración SVG -->
    <div class="absolute inset-0 z-1">
      <HeroDecoration />
    </div>

    <!-- Contenido -->
    <div class="relative z-10 space-y-8 max-w-4xl">
      <h1 class="fade-in-up text-6xl md:text-8xl font-bold font-['Playfair_Display'] tracking-tight leading-tight">
        CALÚ
      </h1>

      <p class="fade-in-up text-lg md:text-2xl opacity-90 font-light tracking-wide text-gray-300" data-i18n="heroSubtitle">
        Cantante • Compositora • Artista
      </p>

      <p class="fade-in-up text-base md:text-lg text-gray-400 max-w-2xl mx-auto" data-i18n="heroDesc">
        Descubre mi música, álbumes y videos. Cada canción es un viaje, cada nota una historia.
      </p>

      <div class="fade-in-up flex flex-col sm:flex-row justify-center gap-4 pt-6">
        <Button href="https://open.spotify.com/intl-es/artist/7l8ZnvSgps3wMZWonJTgUk" variant="primary" target="_blank" data-i18n="listenSpotify">
          Escuchar en Spotify
        </Button>
        <Button href="https://www.youtube.com/@calu_music" variant="secondary" target="_blank" data-i18n="watchYoutube">
          Ver en YouTube
        </Button>
      </div>

      <!-- Scroll indicator -->
      <div class="fade-in-up pt-12 animate-bounce opacity-0">
        <svg class="w-6 h-6 mx-auto scroll-indicator" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
      </div>
    </div>
  </section>

  <!-- Sección Álbumes -->
  <section class="py-20 md:py-32 relative overflow-hidden albums-section">
    <div class="absolute inset-0 albums-background"></div>
    
    <div class="max-w-6xl mx-auto px-6 relative z-10">
      <SectionTitle 
        title="Mis Álbumes"
        subtitle="Selecciona un álbum para cambiar el tema de la página"
        titleI18n="albumsTitle"
        subtitleI18n="albumsSubtitle"
      />

      <AlbumSelector />
    </div>
  </section>

  <!-- Sección Canciones -->
  <section class="py-20 md:py-32 songs-section relative">
    <div class="absolute inset-0 songs-bg"></div>
    <div class="max-w-7xl mx-auto px-6 relative z-10">
      <SectionTitle 
        title="Mis Canciones"
        subtitle="Haz clic en cualquier canción para escucharla"
        titleI18n="songsTitle"
        subtitleI18n="songsSubtitle"
      />
      
      {songs.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
          {songs.map((song) => (
            <SongCard
              title={song.title}
              artist="CALÚ"
              album={song.album}
              year={song.year}
              duration={song.duration}
              image={song.image}
              spotifyTrackId={song.spotifyTrackId}
              spotifyUrl={song.spotifyUrl}
              albumName={song.album}
            />
          ))}
        </div>
      ) : (
        <div class="text-center py-12">
          <p class="text-gray-400 mb-4" data-i18n="songsEmpty">Las canciones se mostrarán aquí una vez que las agregues</p>
          <p class="text-sm text-gray-500" data-i18n="songsEdit">Edita el archivo <code class="bg-black/30 px-2 py-1 rounded">src/lib/songs.ts</code> para agregar canciones</p>
        </div>
      )}
      
      <div class="text-center mt-12">
        <Button href="https://open.spotify.com/intl-es/artist/7l8ZnvSgps3wMZWonJTgUk" variant="primary" target="_blank" data-i18n="viewAllSpotify">
          Ver todas las canciones en Spotify
        </Button>
      </div>
    </div>
  </section>

  <!-- Videos de YouTube -->
  <section class="py-20 md:py-32 videos-section relative">
    <div class="absolute inset-0 videos-bg"></div>
    <div class="max-w-7xl mx-auto px-6 relative z-10">
      <SectionTitle 
        title="Videos Musicales"
        subtitle="Mira mis últimos videos y presentaciones en vivo"
        titleI18n="videosTitle"
        subtitleI18n="videosSubtitle"
      />
      
      {youtubeVideos.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
          {youtubeVideos.map((video) => (
            <YouTubeVideoCard
              videoId={video.videoId}
              title={video.title}
              description={video.description}
              publishedAt={video.publishedAt}
            />
          ))}
        </div>
      ) : (
        <div class="text-center py-12">
          <p class="text-gray-400 mb-4" data-i18n="videosEmpty">Los videos se mostrarán aquí una vez que los agregues</p>
          <p class="text-sm text-gray-500" data-i18n="videosEdit">Edita el archivo <code class="bg-black/30 px-2 py-1 rounded">src/lib/youtube.ts</code> para agregar videos</p>
        </div>
      )}
      
      <div class="text-center">
        <Button href="https://www.youtube.com/@calu_music" variant="primary" target="_blank" data-i18n="viewMoreYoutube">
          Ver más videos en YouTube
        </Button>
      </div>
    </div>
  </section>

  <!-- Plataformas Streaming -->
  <section class="py-20 md:py-32 platforms-section relative">
    <div class="absolute inset-0 platforms-bg"></div>
    <div class="max-w-6xl mx-auto px-6 relative z-10">
      <SectionTitle 
        title="Escucha en Todas Partes"
        subtitle="Mi música disponible en todas las plataformas"
        titleI18n="platformsTitle"
        subtitleI18n="platformsSubtitle"
      />
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <Card
          icon="🎵"
          title="Spotify"
          description="Escucha todos mis álbumes y singles en Spotify"
          descriptionI18n="platformSpotifyDesc"
          href="https://open.spotify.com/intl-es/artist/7l8ZnvSgps3wMZWonJTgUk"
        />
        
        <Card
          icon="📱"
          title="Apple Music"
          description="Disfruta de mi música en Apple Music"
          descriptionI18n="platformAppleDesc"
          href="https://music.apple.com/artist/calú"
        />
        
        <Card
          icon="🎧"
          title="YouTube Music"
          description="Escucha y mira mis videos en YouTube Music"
          descriptionI18n="platformYoutubeDesc"
          href="https://www.youtube.com/@calu_music"
        />
      </div>
    </div>
  </section>
</MainLayout>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .fade-in-up {
    animation: fadeInUp 0.8s ease-out forwards;
  }

  .fade-in-up:nth-child(1) {
    animation-delay: 0.2s;
    opacity: 0;
  }

  .fade-in-up:nth-child(2) {
    animation-delay: 0.4s;
    opacity: 0;
  }

  .fade-in-up:nth-child(3) {
    animation-delay: 0.6s;
    opacity: 0;
  }
  
  .scroll-indicator {
    color: var(--accent-color, #F472B6);
  }
  
  /* Fondos dinámicos */
  .hero-background {
    background: linear-gradient(to bottom right, 
      rgba(0, 0, 0, 0.8) 0%, 
      var(--primary-color, #EC4899) 20%,
      rgba(0, 0, 0, 0.9) 100%);
    opacity: 0.3;
  }
  
  .albums-section {
    background: linear-gradient(to bottom, 
      rgba(0, 0, 0, 0.5) 0%,
      var(--accent-color, #F472B6) 20%,
      rgba(0, 0, 0, 0.7) 100%);
  }
  
  .albums-background {
    background: linear-gradient(135deg, 
      var(--primary-color, #EC4899) 0%,
      var(--secondary-color, #831843) 50%,
      var(--accent-color, #F472B6) 100%);
    opacity: 0.15;
  }
  
  .songs-section {
    position: relative;
  }
  
  .songs-bg {
    background: linear-gradient(to bottom, 
      rgba(0, 0, 0, 0.6) 0%,
      var(--secondary-color, #831843) 15%,
      rgba(0, 0, 0, 0.8) 100%);
    opacity: 0.3;
  }
  
  .videos-section {
    position: relative;
  }
  
  .videos-bg {
    background: linear-gradient(to bottom, 
      rgba(0, 0, 0, 0.7) 0%,
      var(--primary-color, #EC4899) 20%,
      rgba(0, 0, 0, 0.9) 100%);
    opacity: 0.25;
  }
  
  .platforms-section {
    position: relative;
  }
  
  .platforms-bg {
    background: linear-gradient(to bottom, 
      rgba(0, 0, 0, 0.7) 0%,
      var(--accent-color, #F472B6) 15%,
      rgba(0, 0, 0, 0.9) 100%);
    opacity: 0.2;
  }
</style>
