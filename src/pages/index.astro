---
import MainLayout from "../layouts/MainLayout.astro";
import Button from "../components/Button.astro";
import HeroDecoration from "../components/HeroDecoration.astro";
import Card from "../components/Card.astro";
import SectionTitle from "../components/SectionTitle.astro";
---

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .fade-in-up {
    animation: fadeInUp 0.8s ease-out forwards;
  }

  .fade-in-up:nth-child(1) {
    animation-delay: 0.2s;
    opacity: 0;
  }

  .fade-in-up:nth-child(2) {
    animation-delay: 0.4s;
    opacity: 0;
  }

  .fade-in-up:nth-child(3) {
    animation-delay: 0.6s;
    opacity: 0;
  }
</style>

<MainLayout title="Inicio | CALÚ">
  <!-- Hero Section -->
  <section class="relative min-h-screen flex items-center justify-center text-center px-6 overflow-hidden">
    
    <!-- Fondo degradado -->
    <div class="absolute inset-0 bg-linear-to-br from-black via-pink-950/20 to-black z-0"></div>

    <!-- Decoración SVG -->
    <div class="absolute inset-0 z-1">
      <HeroDecoration />
    </div>

    <!-- Contenido -->
    <div class="relative z-10 space-y-8 max-w-4xl">
      <h1 class="fade-in-up text-6xl md:text-8xl font-bold font-['Playfair_Display'] tracking-tight leading-tight">
        CALÚ
      </h1>

      <p class="fade-in-up text-lg md:text-2xl opacity-90 font-light tracking-wide text-gray-300">
        Cantante • Compositora • Artista
      </p>

      <div class="fade-in-up flex flex-col sm:flex-row justify-center gap-4 pt-6">
        <Button href="/music" variant="secondary">
          Escuchar música
        </Button>

        <Button href="/events" variant="primary">
          Próximos eventos
        </Button>
      </div>

      <!-- Scroll indicator -->
      <div class="fade-in-up pt-12 animate-bounce opacity-0">
        <svg class="w-6 h-6 mx-auto text-pink-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
      </div>
    </div>
  </section>

  <!-- Sección Intro -->
  <section class="py-20 md:py-32 bg-linear-to-br from-pink-950 via-black to-black text-white relative overflow-hidden">
    <!-- Elementos decorativos de fondo -->
    <div class="absolute top-0 right-0 w-72 h-72 bg-pink-500/10 rounded-full blur-3xl -mr-36 -mt-36"></div>
    <div class="absolute bottom-0 left-0 w-72 h-72 bg-pink-400/5 rounded-full blur-3xl -ml-36 -mb-36"></div>
    
    <div class="relative max-w-3xl mx-auto px-6 text-center space-y-6">
      <h2 class="text-4xl md:text-5xl font-bold font-['Playfair_Display']">
        Bienvenido a mi mundo musical
      </h2>
      <p class="text-lg text-gray-300 leading-relaxed">
        Explorando nuevos sonidos, emociones y formas de expresión artística. Cada canción es un viaje, cada nota una historia. Te invito a ser parte de esta experiencia musical.
      </p>
    </div>
  </section>

  <!-- Sección Highlights/Features -->
  <section class="py-20 md:py-32 bg-linear-to-b from-black to-pink-950/10 relative overflow-hidden">
    <!-- Elementos decorativos animados -->
    <div class="absolute top-0 right-0 w-96 h-96 bg-pink-500/15 rounded-full blur-3xl -mr-48 -mt-48 opacity-60"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 bg-pink-400/10 rounded-full blur-3xl -ml-48 -mb-48 opacity-50"></div>
    
    <div class="max-w-6xl mx-auto px-6 relative z-10">
      <SectionTitle 
        title="Mi Arte"
        subtitle="Descubre lo que definen mi carrera artística"
      />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <Card
          icon="🎤"
          title="Artista Versátil"
          description="Cantante y compositora con una voz única y presencia escénica cautivadora en cada presentación"
          href="/biography"
        />
        
        <Card
          icon="🎵"
          title="Música Original"
          description="Más de 50 canciones propias que exploran emociones profundas y sonidos contemporáneos"
          href="/music"
        />
        
        <Card
          icon="🌟"
          title="En Vivo"
          description="Presentaciones en escenarios nacionales e internacionales con conexión auténtica con el público"
          href="/events"
        />
      </div>
    </div>
  </section>

  <!-- Sección Últimas Canciones -->
  <section class="py-20 md:py-32 bg-linear-to-b from-black via-pink-950/10 to-black relative overflow-hidden">
    <!-- Elementos decorativos -->
    <div class="absolute inset-0 opacity-30">
      <div class="absolute top-20 left-10 w-40 h-40 bg-pink-500/20 rounded-full blur-3xl"></div>
      <div class="absolute bottom-20 right-10 w-40 h-40 bg-pink-600/20 rounded-full blur-3xl"></div>
    </div>
    
    <div class="max-w-6xl mx-auto px-6 relative z-10">
      <SectionTitle 
        title="Últimas Canciones"
        subtitle="Escucha mis composiciones más recientes"
      />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="group cursor-pointer">
          <div class="aspect-square bg-linear-to-b from-pink-600 to-pink-900 rounded-lg mb-4 flex items-center justify-center group-hover:scale-105 transition duration-300 overflow-hidden">
            <div class="text-center">
              <p class="text-5xl mb-2">♪</p>
              <p class="text-sm opacity-75">Escuchar</p>
            </div>
          </div>
          <h3 class="font-bold text-lg group-hover:text-pink-400 transition">Canción 1</h3>
          <p class="text-gray-400 text-sm">2025 • 3:45</p>
        </div>

        <div class="group cursor-pointer">
          <div class="aspect-square bg-linear-to-br from-pink-700 to-purple-900 rounded-lg mb-4 flex items-center justify-center group-hover:scale-105 transition duration-300 overflow-hidden">
            <div class="text-center">
              <p class="text-5xl mb-2">♪</p>
              <p class="text-sm opacity-75">Escuchar</p>
            </div>
          </div>
          <h3 class="font-bold text-lg group-hover:text-pink-400 transition">Canción 2</h3>
          <p class="text-gray-400 text-sm">2025 • 4:12</p>
        </div>

        <div class="group cursor-pointer">
          <div class="aspect-square bg-linear-to-br from-rose-600 to-pink-900 rounded-lg mb-4 flex items-center justify-center group-hover:scale-105 transition duration-300 overflow-hidden">
            <div class="text-center">
              <p class="text-5xl mb-2">♪</p>
              <p class="text-sm opacity-75">Escuchar</p>
            </div>
          </div>
          <h3 class="font-bold text-lg group-hover:text-pink-400 transition">Canción 3</h3>
          <p class="text-gray-400 text-sm">2024 • 3:28</p>
        </div>
      </div>

      <div class="flex justify-center mt-12">
        <Button href="/music" variant="primary">
          Ver todas las canciones
        </Button>
    <!-- Efecto de luz -->
    <div class="absolute inset-0 opacity-40">
      <div class="absolute top-1/2 left-1/2 w-96 h-96 bg-pink-500/20 rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2"></div>
    </div>
    </section>

  <!-- Sección CTA -->
  <section class="py-20 md:py-32 bg-linear-to-r from-pink-950/20 to-black">
    <div class="max-w-4xl mx-auto px-6 text-center space-y-8">
      <h2 class="text-4xl md:text-5xl font-bold font-['Playfair_Display']">
        ¿Quieres saber más?
      </h2>
      <p class="text-xl text-gray-300">
        Explora mi biografía, galería de fotos y próximos eventos
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <Button href="/biography" variant="primary">
          Mi Biografía
        </Button>
        <Button href="/galery" variant="secondary">
          Galería
        </Button>
        <Button href="/contact" variant="secondary">
          Contactame
        </Button>
      </div>
    </div>
  </section>
</MainLayout>
